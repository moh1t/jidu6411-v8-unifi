# ---- target: JioRouter AX6000 JIDU6J11 (device selected by build.sh) ----
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# ---- web UI over HTTPS (uhttpd TLS + certificate generator) ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# ---- kernel modules that must match this kernel (cannot come from the feed later) ----
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-batman-adv=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_kmod-tun=y
# ---- tools ----
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_zram-swap=y
# full wpad (802.11k/v/r, SAE/WPA3) instead of wpad-basic
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y

# Hardware firmware and board data must also be present in each image.
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_jidu6j11-board-data=y
CONFIG_PACKAGE_ath11k-firmware-ipq9574=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=y
